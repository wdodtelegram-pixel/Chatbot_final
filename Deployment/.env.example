# =======================================================================
# Copy this file to ".env" (delete the ".example" part) and fill it in.
# NEVER commit .env to git -- it contains your bot token.
# =======================================================================

# -----------------------------------------------------------------------
# REQUIRED: your bot token.
#
# Get it by messaging @BotFather on Telegram and sending /newbot.
# He replies with a long string that looks like this:
#
#     8123456789:AAHk3jd8sLqPqR7tYuIoP1aSdFgHjKlZxCv
#
# Paste it directly after the "=" below. Do NOT add quotes or spaces.
# Already have a bot? Send /mybots to @BotFather -> pick it -> API Token.
# -----------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8877801544:AAGK_nVbyJO93KMys54P0xd4Oc8BIsQgz3A

# -----------------------------------------------------------------------
# OPTIONAL: full path to the OneDrive-synced workbook.
#
# Leave this BLANK while testing -- the bot then uses the local file at
# ./data/maintenance_jobs.xlsx that create_workbook.py generates.
#
# When you go live, point it at your OneDrive copy. Use FORWARD slashes:
#   EXCEL_PATH=C:/Users/limju/OneDrive - YourCompany/FM/maintenance_jobs.xlsx
# -----------------------------------------------------------------------
EXCEL_PATH=

# -----------------------------------------------------------------------
# OPTIONAL: name of the worksheet tab holding the job rows.
# Blank means "Jobs".
# -----------------------------------------------------------------------
SHEET_NAME=

# -----------------------------------------------------------------------
# OPTIONAL: only needed if the machine running the bot has NO OneDrive
# desktop client (e.g. a cloud VM). Paste an "anyone with the link can
# view" share URL. Leave blank for normal OneDrive desktop sync.
# -----------------------------------------------------------------------
ONEDRIVE_SHARE_LINK=

# -----------------------------------------------------------------------
# OPTIONAL: how often (seconds) to re-read the workbook in the background.
# Blank means 300 (5 minutes).
# -----------------------------------------------------------------------
REFRESH_INTERVAL_SECONDS=300

# =======================================================================
# OPTION C: Google Form -> published CSV  (no Google Cloud)
# Only fill these in if you want to use a Google Form instead of Excel.
# See GOOGLE_FORM_SETUP.md for the full walkthrough.
# =======================================================================

# Set to "google_csv" to read from a published Google Sheet instead of
# a local Excel file. Blank or "excel" = use the Excel file above.
DATA_SOURCE=google_csv

# The "Publish to web" CSV link for your Google Form's response sheet.
# Must end in output=csv. Only used when DATA_SOURCE=google_csv.
GOOGLE_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vR0cV4YoNrsI9Wupau9N2v_glxe1WgvllO6M4SHMlO-YR0yQx6VNgi7PQPsrZpWVRNOhAYCdtrR0Spj/pub?output=csv

# Keep only the newest submission per Job ID (a Form only adds rows, so
# resubmitting with the same Job ID is how you "update" a job).
# Blank means true.
DEDUPE_BY_JOB_ID=

# The Form timestamp date order. true = day-first (SG/UK), false = US.
# Blank means true.
FORM_TIMESTAMP_DAYFIRST=
